# Backend environment variables (copy to be/.env and fill in real values)

PROJECT_NAME=OrganTrust
API_V1_STR=/api/v1

# Neon PostgreSQL connection string (preferred)
# Get this from your Neon project dashboard: https://console.neon.tech
DATABASE_URL=postgresql+psycopg2://user:password@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require

# Alternative: individual connection components (used if DATABASE_URL is not set)
# POSTGRES_SERVER=localhost
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=organtrust
# POSTGRES_PORT=5432

# Security keys — replace all of these with strong random values in production
SECRET_KEY=change-me-in-production
ENCRYPTION_KEY=32-byte-key-change-in-production
PSEUDONYM_HMAC_KEY=32-byte-key-change-in-production
SIGNING_KEY=32-byte-key-change-in-production
AUDIT_SIGNING_KEY_HEX=64-hex-char-key-change-in-production
